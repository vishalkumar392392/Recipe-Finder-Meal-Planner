  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "lib": ["dom", "es2017"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@stencil/core",
    "module": "esnext",
    "target": "es2017"
  },
  "include": ["src"]
